---
import Logo from './Logo.astro';
import site from '../content/site.json';

const phoneHref = site.contact.phone.replace(/[^\d+]/g, '');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="Комбит Про — на главную">
      <Logo />
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      {(site.navigation ?? []).map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-phone" href={`tel:${phoneHref}`}>
      <span>{site.contact.phone}</span>
      <small>{site.contact.headerCta}</small>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Открыть меню"><span></span><span></span><span></span></summary>
      <nav aria-label="Мобильная навигация">
        {(site.navigation ?? []).map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={`tel:${phoneHref}`}>{site.contact.phone}</a>
      </nav>
    </details>
  </div>
</header>

