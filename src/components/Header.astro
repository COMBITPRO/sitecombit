---
import Logo from './Logo.astro';

const navigation = [
  { href: '#about', label: 'О компании' },
  { href: '#equipment', label: 'Оборудование' },
  { href: '#services', label: 'Услуги' },
  { href: '#projects', label: 'Проекты' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="Комбит Про — на главную">
      <Logo />
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-phone" href="tel:+74999224010">
      <span>+7 (499) 922-40-10</span>
      <small>Связаться с нами</small>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Открыть меню"><span></span><span></span><span></span></summary>
      <nav aria-label="Мобильная навигация">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="tel:+74999224010">+7 (499) 922-40-10</a>
      </nav>
    </details>
  </div>
</header>

