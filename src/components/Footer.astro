---
import Logo from './Logo.astro';
import site from '../content/site.json';

const phoneHref = site.contact.phone.replace(/[^\d+]/g, '');
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-footer" href="#top" aria-label="Комбит Про — наверх">
        <Logo />
      </a>
      <p>{site.footer.description}</p>
    </div>
    <div class="footer-links">
      <strong>{site.footer.sectionsTitle}</strong>
      {site.footer.links.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="footer-links">
      <strong>{site.footer.contactsTitle}</strong>
      <a href={`tel:${phoneHref}`}>{site.contact.phone}</a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <span>{site.contact.address}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.footer.copyright}</span>
    <span>{site.footer.disclaimer}</span>
  </div>
</footer>
