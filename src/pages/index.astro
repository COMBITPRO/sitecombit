---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import '../styles/global.css';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
const phoneHref = site.contact.phone.replace(/[^\d+]/g, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content="#003357" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.seo.title}</title>
  </head>
  <body id="top">
    <Header />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1 id="hero-title">{site.hero.title}<br /><span>{site.hero.accentTitle}</span></h1>
            <p class="hero-description">{site.hero.description}</p>
            <div class="hero-actions">
              <a class="button" href="#contacts">{site.hero.primaryButton} <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 15 10-10m0 0H7m8 0v8" stroke="currentColor" stroke-width="1.8" /></svg></a>
              <a class="button button-outline" href="#equipment">{site.hero.secondaryButton}</a>
            </div>
          </div>
          <div class="hero-facts" aria-label="Ключевые показатели">
            {site.hero.facts.map((fact) => <div class="hero-fact"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
          </div>
        </div>
      </section>

      <aside class="dealer-strip" aria-label="Официальный статус">
        <div class="container dealer-inner">
          <div class="dealer-copy"><span class="dealer-badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6.5 12.5 3.5 3.5 7.5-8" /></svg></span><div><strong>{site.dealer.title}</strong><span>{site.dealer.description}</span></div></div>
          <span class="dealer-label">{site.dealer.label}</span>
        </div>
      </aside>

      <section class="section" id="about">
        <div class="container about-grid">
          <div class="about-visual">
            <img src={site.about.image} alt={site.about.imageAlt} loading="lazy" />
            <div class="about-stamp"><strong>{site.about.stampValue}</strong><span>{site.about.stampText}</span></div>
          </div>
          <div class="about-copy">
            <p class="eyebrow">{site.about.eyebrow}</p>
            <h2 class="section-title">{site.about.title}</h2>
            <p>{site.about.description}</p>
            <ul class="industry-list">
              {site.about.industries.map((industry) => <li>{industry}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section section-muted" id="equipment">
        <div class="container">
          <div class="equipment-header"><div><p class="eyebrow">{site.equipment.eyebrow}</p><h2 class="section-title">{site.equipment.title}</h2></div><p class="section-lead">{site.equipment.lead}</p></div>
          <div class="equipment-grid">
            {site.equipment.items.map((item) => (
              <article class="product-card">
                <div class="product-image"><img src={item.image} alt={item.alt} loading="lazy" /></div>
                <div class="product-body"><span class="product-kicker">{item.kicker}</span><h3>{item.title}</h3><p>{item.description}</p><div class="product-meta">{item.meta.map((label) => <span>{label}</span>)}</div></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section services-section" id="services">
        <div class="container">
          <div class="services-header"><div><p class="eyebrow">{site.services.eyebrow}</p><h2 class="section-title">{site.services.title}</h2></div><p class="section-lead">{site.services.lead}</p></div>
          <div class="services-grid">
            {site.services.items.map((item, index) => <article class="service-card"><span class="service-number">{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container advantages">
          <div class="advantages-aside"><p class="eyebrow">{site.advantages.eyebrow}</p><h2 class="section-title">{site.advantages.title}</h2><p class="section-lead">{site.advantages.lead}</p></div>
          <div class="advantage-list">{site.advantages.items.map((item) => <article class="advantage-item"><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
        </div>
      </section>

      <section class="section projects-section" id="projects">
        <div class="container">
          <div class="project-intro"><div><p class="eyebrow">{site.projects.eyebrow}</p><h2 class="section-title">{site.projects.title}</h2></div><p>{site.projects.lead}</p></div>
          <div class="stats-grid">
            {site.projects.stats.map((stat) => <div class="stat-card"><strong>{stat.value}{stat.suffix && <span>{stat.suffix}</span>}</strong><p>{stat.description}</p></div>)}
          </div>
          <div class="project-list">{site.projects.items.map((project, index) => <div class="project-item"><span>{String(index + 1).padStart(2, '0')}</span><p>{project}</p></div>)}</div>
        </div>
      </section>

      <section class="section" aria-labelledby="clients-title">
        <div class="container">
          <div class="clients-header"><div><p class="eyebrow">{site.clients.eyebrow}</p><h2 class="section-title" id="clients-title">{site.clients.title}</h2></div><p>{site.clients.lead}</p></div>
          <div class="client-grid">{site.clients.items.map((item) => <div class="client-logo"><img src={item.image} alt={item.alt} loading="lazy" /></div>)}</div>
        </div>
      </section>

      <section class="section contact-section" id="contacts">
        <div class="container contact-grid">
          <div class="contact-copy">
            <p class="eyebrow">{site.contactSection.eyebrow}</p><h2 class="section-title">{site.contactSection.title}</h2><p>{site.contactSection.lead}</p>
            <div class="contact-details">
              <div class="contact-detail"><span>Телефон</span><a href={`tel:${phoneHref}`}>{site.contact.phone}</a></div>
              <div class="contact-detail"><span>Почта</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
              <div class="contact-detail"><span>Адрес</span><address>{site.contact.address}</address></div>
            </div>
          </div>

          <div class="contact-form-wrap">
            <h3>{site.contactSection.form.title}</h3><p>{site.contactSection.form.lead}</p>
            <form
              class="contact-form"
              id="contact-form"
              data-endpoint={formspreeEndpoint}
              data-sending={site.contactSection.form.sending}
              data-pending={site.contactSection.form.pending}
              data-success={site.contactSection.form.success}
              data-error={site.contactSection.form.error}
              data-phone={site.contact.phone}
            >
              <input type="hidden" name="_subject" value="Новая заявка с сайта Комбит Про" />
              <div class="form-field"><label for="name">{site.contactSection.form.nameLabel}</label><input id="name" name="name" autocomplete="name" required /></div>
              <div class="form-field"><label for="company">{site.contactSection.form.companyLabel}</label><input id="company" name="company" autocomplete="organization" /></div>
              <div class="form-field form-field-full"><label for="contact">{site.contactSection.form.contactLabel}</label><input id="contact" name="contact" autocomplete="email" required /></div>
              <div class="form-field form-field-full"><label for="message">{site.contactSection.form.messageLabel}</label><textarea id="message" name="message"></textarea></div>
              <label class="form-consent"><input type="checkbox" name="consent" value="Да" required /><span>{site.contactSection.form.consent}</span></label>
              <div class="form-footer"><button class="button" type="submit" disabled={!formspreeEndpoint}>{site.contactSection.form.button}</button><p class="form-status" id="form-status" aria-live="polite">{formspreeEndpoint ? site.contactSection.form.ready : site.contactSection.form.unavailable}</p></div>
            </form>
          </div>
        </div>
        <div class="map-wrap"><iframe src="https://yandex.ru/map-widget/v1/?ll=37.507599%2C55.743124&mode=search&oid=93740059845&ol=biz&z=14.8" title="Комбит Про на Яндекс Картах" loading="lazy"></iframe></div>
      </section>
    </main>

    <Footer />

    <script>
      const form = document.querySelector<HTMLFormElement>('#contact-form');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const endpoint = form.dataset.endpoint;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>('#form-status');

        if (!endpoint || !button || !status) return;

        const initialButtonText = button.textContent;
        button.disabled = true;
        button.textContent = form.dataset.sending || 'Отправляем…';
        status.dataset.state = 'pending';
        status.textContent = form.dataset.pending || 'Отправляем заявку…';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (!response.ok) throw new Error(`Formspree returned ${response.status}`);

          form.reset();
          status.dataset.state = 'success';
          status.textContent = form.dataset.success || 'Спасибо! Заявка отправлена.';
        } catch (error) {
          console.error(error);
          status.dataset.state = 'error';
          status.textContent = `${form.dataset.error || 'Не удалось отправить заявку.'} ${form.dataset.phone || ''}`.trim();
        } finally {
          button.disabled = false;
          button.textContent = initialButtonText;
        }
      });
    </script>
  </body>
</html>
