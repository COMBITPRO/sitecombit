---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import '../styles/global.css';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
const phoneHref = site.contact.phone.replace(/[^\d+]/g, '');
const orderedModels = <T extends { featured?: boolean }>(models: T[] = []) => [...models].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.seo.description} />
    <meta name="theme-color" content="#003357" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.seo.title}</title>
  </head>
  <body id="top">
    <Header />

    <main>
      <section class="hero" aria-labelledby="hero-title" style={`--hero-image: url("${site.hero.image}")`}>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1 id="hero-title">{site.hero.title}<br /><span>{site.hero.accentTitle}</span></h1>
            {site.hero.description && <p class="hero-description rich-text">{site.hero.description}</p>}
            <div class="hero-actions">
              <a class="button" href="#contacts">{site.hero.primaryButton} <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 15 10-10m0 0H7m8 0v8" stroke="currentColor" stroke-width="1.8" /></svg></a>
              <a class="button button-outline" href="#equipment">{site.hero.secondaryButton}</a>
            </div>
          </div>
          <div class="hero-facts" aria-label="Ключевые показатели">
            {(site.hero.facts ?? []).map((fact) => <div class="hero-fact"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
          </div>
        </div>
      </section>

      <section class="section" id="audience">
        <div class="container about-grid">
          <div class="about-visual">
            <img src={site.about.image} alt={site.about.imageAlt} loading="lazy" />
            <div class="about-stamp"><strong>{site.about.stampValue}</strong><span>{site.about.stampText}</span></div>
          </div>
          <div class="about-copy">
            <p class="eyebrow">{site.about.eyebrow}</p>
            <h2 class="about-statement">{site.about.title}</h2>
            {site.about.description && <p class="rich-text">{site.about.description}</p>}
            <ul class="industry-list">
              {(site.about.industries ?? []).map((industry) => <li>{industry}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <aside class="dealer-strip" aria-label="Официальный статус">
        <div class="container dealer-inner">
          <div class="dealer-copy"><span class="dealer-badge" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6.5 12.5 3.5 3.5 7.5-8" /></svg></span><div><strong>{site.dealer.title}</strong>{site.dealer.description && <span>{site.dealer.description}</span>}</div></div>
          <span class="dealer-label">{site.dealer.label}</span>
        </div>
      </aside>

      <section class="section" id="clients" aria-labelledby="clients-title">
        <div class="container">
          <div class="clients-header"><div><p class="eyebrow">{site.clients.eyebrow}</p><h2 class="section-title" id="clients-title">{site.clients.title}</h2></div>{site.clients.lead && <p class="rich-text">{site.clients.lead}</p>}</div>
          <div class="client-grid">{(site.clients.items ?? []).map((item) => <div class="client-logo"><img src={item.image} alt={item.alt} loading="lazy" /></div>)}</div>
          <ul class="client-name-list">{(site.clients.names ?? []).map((name) => <li>{name}</li>)}</ul>
          {site.clients.closing && <p class="clients-closing rich-text">{site.clients.closing}</p>}
        </div>
      </section>

      <section class="section">
        <div class="container advantages">
          <div class="advantages-aside"><p class="eyebrow">{site.advantages.eyebrow}</p><h2 class="section-title">{site.advantages.title}</h2></div>
          <div><div class="advantage-list">{(site.advantages.items ?? []).map((item) => <article class="advantage-item"><div><h3>{item.title}</h3>{item.description && <p class="rich-text">{item.description}</p>}</div></article>)}</div>{site.advantages.closing && <p class="advantages-closing rich-text">{site.advantages.closing}</p>}</div>
        </div>
      </section>

      <section class="section section-muted" id="equipment">
        <div class="container">
          <div class="equipment-header"><div><p class="eyebrow">{site.equipment.eyebrow}</p><h2 class="section-title section-title-long">{site.equipment.title}</h2></div>{site.equipment.lead && <p class="section-lead rich-text">{site.equipment.lead}</p>}</div>

          <div class="equipment-tabs" role="tablist" aria-label="Группы измерительного оборудования">
            {(site.equipment.groups ?? []).map((group, index) => (
              <button
                id={`equipment-tab-${group.id}`}
                class="equipment-tab"
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`equipment-panel-${group.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-equipment-tab={group.id}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                {group.label}
                {(group.models ?? []).length > 1 && <small>{(group.models ?? []).length} модели</small>}
              </button>
            ))}
          </div>

          <div class="equipment-panels">
            {(site.equipment.groups ?? []).map((group, index) => (
              <section
                id={`equipment-panel-${group.id}`}
                class="equipment-panel"
                role="tabpanel"
                aria-labelledby={`equipment-tab-${group.id}`}
                hidden={index !== 0}
                data-equipment-panel={group.id}
              >
                <p class="equipment-summary rich-text">{group.summary}</p>
                <div class:list={['equipment-models', { 'is-single': (group.models ?? []).length === 1 }]}>
                  {orderedModels(group.models).map((model) => (
                    <article id={`equipment-model-${model.id}`} class:list={['equipment-model', { 'equipment-model-featured': model.featured }]}>
                      <div class="equipment-model-image">
                        <img src={model.image} alt={model.alt} loading="lazy" />
                      </div>
                      <div class="equipment-model-content">
                        <h3>{model.title}</h3>
                        {model.description && <p class="equipment-model-description rich-text">{model.description}</p>}
                        {(model.technicalSpecifications ?? []).length > 0 && (
                          <details class="equipment-tech">
                            <summary>
                              <span>Технические характеристики</span>
                              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                            </summary>
                            <dl>
                              {(model.technicalSpecifications ?? []).map((item: { parameter: string; value: string }) => (
                                <div><dt>{item.parameter}</dt><dd>{item.value}</dd></div>
                              ))}
                            </dl>
                          </details>
                        )}
                        {(model.files ?? []).length > 0 && (
                          <div class="equipment-files" aria-label={`Файлы для ${model.title}`}>
                            {(model.files ?? []).map((file) => (
                              <a href={file.href} download>
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                  <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" />
                                </svg>
                                <span>{file.label}</span>
                                <small>{file.format}</small>
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <section class="additional-solutions" id="additional-solutions" aria-labelledby="additional-solutions-title">
            <div class="additional-solutions-header">
              <div>
                <p class="eyebrow">Комплексные решения</p>
                <h3 id="additional-solutions-title">{site.equipment.additionalTitle}</h3>
              </div>
              {site.equipment.additionalLead && <p class="rich-text">{site.equipment.additionalLead}</p>}
            </div>
            <div class="additional-solutions-grid">
              {(site.equipment.additionalSolutions ?? []).map((solution, index) => (
                <article id={`additional-solution-${index + 1}`} class="additional-solution-card">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h4>{solution.title}</h4>
                  {solution.description && <p class="rich-text">{solution.description}</p>}
                </article>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="section services-section" id="services">
        <div class="container">
          <div class="services-header"><div><p class="eyebrow">{site.services.eyebrow}</p><h2 class="section-title section-title-long">{site.services.title}</h2></div>{site.services.lead && <p class="section-lead rich-text">{site.services.lead}</p>}</div>
          <div class="services-grid">
            {(site.services.items ?? []).map((item, index) => <article class="service-card"><span class="service-number">{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3>{item.description && <p class="rich-text">{item.description}</p>}</article>)}
          </div>
        </div>
      </section>

      <section class="section company-section" id="company">
        <div class="container">
          <div class="company-header"><p class="eyebrow">{site.company.eyebrow}</p><h2 class="section-title">{site.company.title}</h2>{site.company.lead && <p class="section-lead rich-text">{site.company.lead}</p>}</div>
          <h3 class="company-directions-title">{site.company.directionsTitle}</h3>
          <div class="company-directions">{(site.company.directions ?? []).map((direction, index) => <article class="company-direction"><span>{index + 1}</span><div><h3>{direction.title}</h3><ul>{(direction.items ?? []).map((item) => <li>{item}</li>)}</ul></div></article>)}</div>
        </div>
      </section>

      <section class="section projects-section" id="projects">
        <div class="container">
          <div class="project-intro"><div><p class="eyebrow">{site.projects.eyebrow}</p><h2 class="section-title">{site.projects.title}</h2></div>{site.projects.lead && <p class="rich-text">{site.projects.lead}</p>}</div>
          <div class="project-list">{(site.projects.items ?? []).map((project, index) => <div class="project-item"><span>{String(index + 1).padStart(2, '0')}</span><p class="rich-text">{project}</p></div>)}</div>
          {site.projects.afterword && <p class="project-afterword rich-text">{site.projects.afterword}</p>}
          {site.projects.constructionTitle && <h3 class="project-construction-title">{site.projects.constructionTitle}</h3>}
          {(site.projects.constructionItems ?? []).length > 0 && <div class="project-list project-construction-list">{(site.projects.constructionItems ?? []).map((project, index) => <div class="project-item"><span>{String(index + 1).padStart(2, '0')}</span><p class="rich-text">{project}</p></div>)}</div>}
          <div class="stats-grid">
            {(site.projects.stats ?? []).map((stat) => <div class="stat-card"><strong>{stat.value}{stat.suffix && <span>{stat.suffix}</span>}</strong>{stat.description && <p class="rich-text">{stat.description}</p>}</div>)}
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contacts">
        <div class="container contact-grid">
          <div class="contact-copy">
            <p class="eyebrow">{site.contactSection.eyebrow}</p><h2 class="section-title">{site.contactSection.title}</h2><p class="rich-text">{site.contactSection.lead}</p>
            <div class="contact-details">
              <div class="contact-detail"><span>Телефон</span><a href={`tel:${phoneHref}`}>{site.contact.phone}</a></div>
              <div class="contact-detail"><span>Факс</span><span class="contact-value">{site.contact.fax}</span></div>
              <div class="contact-detail"><span>E-mail</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
              <div class="contact-detail"><span>Адрес</span><address class="rich-text">{site.contact.address}</address></div>
            </div>
          </div>

          <div class="contact-form-wrap">
            <h3>{site.contactSection.form.title}</h3><p class="rich-text">{site.contactSection.form.lead}</p>
            <form
              class="contact-form"
              id="contact-form"
              data-endpoint={formspreeEndpoint}
              data-sending={site.contactSection.form.sending}
              data-pending={site.contactSection.form.pending}
              data-success={site.contactSection.form.success}
              data-error={site.contactSection.form.error}
              data-phone={site.contact.phone}
            >
              <input type="hidden" name="_subject" value="Новая заявка с сайта Комбит Про" />
              <div class="form-field"><label for="name">{site.contactSection.form.nameLabel}</label><input id="name" name="name" autocomplete="name" required /></div>
              <div class="form-field"><label for="company">{site.contactSection.form.companyLabel}</label><input id="company" name="company" autocomplete="organization" /></div>
              <div class="form-field form-field-full"><label for="contact">{site.contactSection.form.contactLabel}</label><input id="contact" name="contact" autocomplete="email" required /></div>
              <div class="form-field form-field-full"><label for="message">{site.contactSection.form.messageLabel}</label><textarea id="message" name="message"></textarea></div>
              <label class="form-consent"><input type="checkbox" name="consent" value="Да" required /><span>{site.contactSection.form.consent}</span></label>
              <div class="form-footer"><button class="button" type="submit" disabled={!formspreeEndpoint}>{site.contactSection.form.button}</button><p class="form-status" id="form-status" aria-live="polite">{formspreeEndpoint ? site.contactSection.form.ready : site.contactSection.form.unavailable}</p></div>
            </form>
          </div>
        </div>
        <div class="map-wrap"><iframe src="https://yandex.ru/map-widget/v1/?ll=37.507599%2C55.743124&mode=search&oid=93740059845&ol=biz&z=14.8" title="Комбит Про на Яндекс Картах" loading="lazy"></iframe></div>
      </section>
    </main>

    <Footer />

    <script>
      const equipmentTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-equipment-tab]'));
      const equipmentPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-equipment-panel]'));

      const activateEquipmentTab = (tab: HTMLButtonElement) => {
        const selectedId = tab.dataset.equipmentTab;

        equipmentTabs.forEach((item) => {
          const isSelected = item === tab;
          item.setAttribute('aria-selected', String(isSelected));
          item.tabIndex = isSelected ? 0 : -1;
        });

        equipmentPanels.forEach((panel) => {
          panel.hidden = panel.dataset.equipmentPanel !== selectedId;
        });
      };

      equipmentTabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateEquipmentTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;

          event.preventDefault();
          let nextIndex = index;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + equipmentTabs.length) % equipmentTabs.length;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % equipmentTabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = equipmentTabs.length - 1;

          const nextTab = equipmentTabs[nextIndex];
          activateEquipmentTab(nextTab);
          nextTab.focus();
        });
      });

      document.querySelectorAll<HTMLElement>('[data-equipment-target]').forEach((link) => {
        link.addEventListener('click', () => {
          const targetId = link.dataset.equipmentTarget;
          const targetTab = equipmentTabs.find((tab) => tab.dataset.equipmentTab === targetId);
          if (targetTab) activateEquipmentTab(targetTab);
        });
      });

      const form = document.querySelector<HTMLFormElement>('#contact-form');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const endpoint = form.dataset.endpoint;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>('#form-status');

        if (!endpoint || !button || !status) return;

        const initialButtonText = button.textContent;
        button.disabled = true;
        button.textContent = form.dataset.sending || 'Отправляем…';
        status.dataset.state = 'pending';
        status.textContent = form.dataset.pending || 'Отправляем заявку…';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (!response.ok) throw new Error(`Formspree returned ${response.status}`);

          form.reset();
          status.dataset.state = 'success';
          status.textContent = form.dataset.success || 'Спасибо! Заявка отправлена.';
        } catch (error) {
          console.error(error);
          status.dataset.state = 'error';
          status.textContent = `${form.dataset.error || 'Не удалось отправить заявку.'} ${form.dataset.phone || ''}`.trim();
        } finally {
          button.disabled = false;
          button.textContent = initialButtonText;
        }
      });
    </script>
  </body>
</html>
